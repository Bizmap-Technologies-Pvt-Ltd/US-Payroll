 "font_size": 14,
 "html": "<!DOCTYPE html>\r\n<html>\r\n\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <title>W-3 Overlay</title>\r\n    <style>\r\n        @page {\r\n            size: letter;\r\n            margin: 0;\r\n        }\r\n\r\n        body {\r\n            margin: 0;\r\n            padding: 0;\r\n            font-family: 'Courier New', Courier, monospace;\r\n            font-size: 9px;\r\n        }\r\n\r\n        .print-wrapper {\r\n            position: relative;\r\n            width: 7in;\r\n            height: 10in;\r\n            margin: 0 auto;\r\n            background: url(\"\") no-repeat;\r\n            background-size: 7in 10.9in;\r\n        }\r\n\r\n        .val {\r\n            position: absolute;\r\n            font-weight: 700;\r\n            font-size: 9px;\r\n            white-space: nowrap;\r\n        }\r\n\r\n        .val-left {\r\n            text-align: left;\r\n        }\r\n\r\n        .val-center {\r\n            text-align: center;\r\n        }\r\n\r\n        .val-right {\r\n            text-align: right;\r\n        }\r\n    </style>\r\n</head>\r\n\r\n<body>\r\n\r\n    <div class=\"print-wrapper\">\r\n\r\n        <!-- Control Number -->\r\n        <div class=\"val val-center\" style=\"top:0.3in; left:1.2in; width:2.5in;\">\r\n        </div>\r\n\r\n        <!-- Total number of W-2 forms -->\r\n        <div class=\"val val-right\" style=\"top:1.36in; left:-1.22in; width:2.5in;\">\r\n            {% if doc.employer_identification_number_ein %}{{\r\n            doc.number_of_w2_forms }}{% else\r\n            %}&nbsp;{% endif %}\r\n        </div>\r\n\r\n        <!-- Establishment number -->\r\n        <div class=\"val val-left\" style=\"top:1.2in; left:2.9in; width:2in;\">\r\n        </div>\r\n\r\n        <!-- Box 1 \u2013 Wages, tips, compensation -->\r\n        <div class=\"val val-right\" style=\"top:1.36in; left:3.50in; width:1.4in;\">\r\n            {% if doc.wages_tips_other_compensation %}\r\n            {{ \"{:,.2f}\".format(doc.wages_tips_other_compensation | float) }}\r\n            {% else %}&nbsp;{% endif %}</div>\r\n\r\n        <!-- Box 2 \u2013 Federal income tax withheld -->\r\n        <div class=\"val val-right\" style=\"top:1.36in; left:5.36in; width:1.4in;\">\r\n            {% if doc.federal_income_tax_withheld %}\r\n            {{ \"{:,.2f}\".format(doc.federal_income_tax_withheld | float) }}\r\n            {% else %}&nbsp;{% endif %}\r\n        </div>\r\n\r\n        <!-- EIN -->\r\n        <div class=\"val val-center\" style=\"top:1.7in; left:-0.10in; width:2.5in;\">\r\n            {% if doc.employer_identification_number_ein %}{{\r\n            doc.employer_identification_number_ein }}{% else\r\n            %}&nbsp;{% endif %}\r\n        </div>\r\n\r\n        <!-- Box 3 \u2013 Social Security wages -->\r\n        <div class=\"val val-right\" style=\"top:1.7in; left:3.50in; width:1.4in;\">\r\n            {% if doc.social_security_wages %}{{\r\n            \"{:,.2f}\".format(doc.social_security_wages | float) }}{% else\r\n            %}&nbsp;{% endif %}\r\n        </div>\r\n\r\n        <!-- Box 4 \u2013 Social Security tax withheld -->\r\n        <div class=\"val val-right\" style=\"top:1.7in; left:5.36in; width:1.4in;\">\r\n            {% if doc.social_security_tax_withheld %}{{\r\n            \"{:,.2f}\".format(doc.social_security_tax_withheld | float)\r\n            }}{% else %}&nbsp;{% endif %}</div>\r\n\r\n        <!-- Employer name -->\r\n        <div class=\"val val-left\" style=\"top:2.07in; right:2.3in; width:4.5in;\">\r\n            {% set comp_doc = frappe.get_all(\"Company\", fields=[\"name\",\"company_name\"], limit=1)[0] %}\r\n    {% set comp_name = comp_doc.company_name or \"\" %}\r\n    {% set comp_id = comp_doc.name or \"\" %}\r\n        </div>\r\n\r\n        <!-- Box 5 \u2013 Medicare wages -->\r\n        <div class=\"val val-right\" style=\"top:2.08in; left:3.50in; width:1.4in;\">\r\n            {% if doc.medicare_wages_and_tips %}{{\r\n            \"{:,.2f}\".format(doc.medicare_wages_and_tips | float) }}{% else\r\n            %}&nbsp;{% endif %}\r\n        </div>\r\n\r\n        <!-- Box 6 \u2013 Medicare tax withheld -->\r\n        <div class=\"val val-right\" style=\"top:2.08in; left:5.36in; width:1.4in;\">\r\n            {% if doc.medicare_tax_withheld %}{{\r\n            \"{:,.2f}\".format(doc.medicare_tax_withheld | float) }}{% else\r\n            %}&nbsp;{% endif %}\r\n        </div>\r\n\r\n        <!-- Employer address -->\r\n        <div class=\"val val-left\" style=\"top:2.7in; right:2.3in; width:4.5in; line-height:1.2;\">\r\n            {% set addr = frappe.db.get_value(\"Address\", {\"address_title\": comp_name}, [\r\n            \"address_line1\",\"address_line2\",\"city\",\"state\",\"pincode\",\"country\"\r\n            ], as_dict=True) %}\r\n\r\n            {% if addr %}\r\n            {% if addr.address_line1 %}{{ addr.address_line1 }}<br>{% endif %}\r\n            {% if addr.address_line2 %}{{ addr.address_line2 }}<br>{% endif %}\r\n            {% if addr.city or addr.state or addr.pincode %}\r\n            {{ addr.city }}{% if addr.state %}, {{ addr.state }}{% endif %}\r\n            {% if addr.pincode %} {{ addr.pincode }}{% endif %}<br>\r\n            {% endif %}\r\n            {% if addr.country %}{{ addr.country }}{% endif %}\r\n            {% else %}\r\n            &nbsp;\r\n            {% endif %}\r\n        </div>\r\n\r\n        <!-- Box 7 \u2013 Social security tips -->\r\n        <div class=\"val val-right\" style=\"top:3.3in; left:5.1in; width:1.4in;\">\r\n        </div>\r\n\r\n        <!-- Box 8 \u2013 Allocated tips -->\r\n        <div class=\"val val-right\" style=\"top:3.6in; left:5.1in; width:1.4in;\">\r\n        </div>\r\n\r\n        <!-- Box 9 \u2013 Dependent care benefits -->\r\n        <div class=\"val val-right\" style=\"top:3.9in; left:5.1in; width:1.4in;\">\r\n        </div>\r\n\r\n        <!-- Box 10 \u2013 Nonqualified plans -->\r\n        <div class=\"val val-right\" style=\"top:4.2in; left:5.1in; width:1.4in;\">\r\n        </div>\r\n\r\n        <!-- Box 11 \u2013 Deferred compensation -->\r\n        <div class=\"val val-right\" style=\"top:4.5in; left:5.1in; width:1.4in;\">\r\n        </div>\r\n\r\n        <!-- Box 12a \u2013 Sick pay withheld -->\r\n        <div class=\"val val-right\" style=\"top:4.8in; left:5.1in; width:1.4in;\">\r\n        </div>\r\n\r\n        <!-- Box 12b \u2013 Sick pay use only -->\r\n        <div class=\"val val-right\" style=\"top:5.1in; left:5.1in; width:1.4in;\">\r\n        </div>\r\n\r\n        <!-- Box 13 \u2013 Employer\u2019s state ID -->\r\n        <div class=\"val val-left\" style=\"top:5.4in; left:1.2in; width:2.5in;\">\r\n        </div>\r\n\r\n        <!-- Box 14 \u2013 State income tax -->\r\n        <div class=\"val val-right\" style=\"top:5.4in; left:5.1in; width:1.4in;\">\r\n        </div>\r\n\r\n        <!-- Box 15 \u2013 State -->\r\n        <div class=\"val val-left\" style=\"top:5.7in; left:1.2in; width:2.5in;\">\r\n        </div>\r\n\r\n        <!-- Box 16 \u2013 State wages -->\r\n        <div class=\"val val-right\" style=\"top:5.7in; left:3.6in; width:1.4in;\">\r\n        </div>\r\n\r\n        <!-- Box 17 \u2013 State income tax -->\r\n        <div class=\"val val-right\" style=\"top:5.7in; left:5.1in; width:1.4in;\">\r\n        </div>\r\n\r\n        <!-- Box 18 \u2013 Local wages -->\r\n        <div class=\"val val-right\" style=\"top:6.0in; left:3.6in; width:1.4in;\">\r\n        </div>\r\n\r\n        <!-- Box 19 \u2013 Local income tax -->\r\n        <div class=\"val val-right\" style=\"top:6.0in; left:3.6in; width:1.4in;\">\r\n        </div>\r\n    </div>\r\n</body>",
