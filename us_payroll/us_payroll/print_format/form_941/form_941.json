 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\r\n    .h5 {\r\n        font-size: 12px;\r\n        font-weight: bold;\r\n    }\r\n\r\n    .h1 {\r\n        font-size: 18px;\r\n        font-weight: bold;\r\n    }\r\n\r\n    .form-container {\r\n        border: 1px solid black;\r\n        padding: 10px;\r\n        width: 62%;\r\n        font-size: 13px;\r\n        box-sizing: border-box;\r\n        display: inline-block;\r\n        vertical-align: top;\r\n    }\r\n\r\n    .half-section {\r\n        width: 33%;\r\n        font-size: 12px;\r\n        box-sizing: border-box;\r\n        display: inline-block;\r\n        vertical-align: top;\r\n    }\r\n\r\n    .form-section {\r\n        border: 1px solid black;\r\n        padding: 4px;\r\n        margin-bottom: 5px;\r\n        box-sizing: border-box;\r\n    }\r\n\r\n    .input-box {\r\n        width: 100px;\r\n        height: 20px;\r\n        margin-bottom: 5px;\r\n        display: inline-block;\r\n        border: 1px solid #000;\r\n        vertical-align: middle;\r\n    }\r\n\r\n    .input-box.small {\r\n        width: 35px;\r\n    }\r\n\r\n    .ein-container {\r\n        gap: 4px;\r\n        flex-wrap: wrap;\r\n    }\r\n\r\n\r\n\r\n    /* Align checkboxes and labels using a table for better PDF compatibility */\r\n    .checkbox-container {\r\n        display: table;\r\n        width: 100%;\r\n        margin-bottom: 2px;\r\n    }\r\n\r\n    .checkbox {\r\n        display: table-cell;\r\n        width: 12px;\r\n        height: 12px;\r\n        border: 1px solid black;\r\n        vertical-align: middle;\r\n        margin-right: 6px;\r\n    }\r\n\r\n    .checkbox-label {\r\n        display: table-cell;\r\n        vertical-align: middle;\r\n        font-size: 10px;\r\n    }\r\n\r\n    .flex-row {\r\n        display: flex;\r\n        justify-content: space-between;\r\n        align-items: flex-start;\r\n        width: 100%;\r\n    }\r\n\r\n    .border {\r\n        border-top: 2px solid black;\r\n        border-bottom: 2px solid black;\r\n    }\r\n\r\n    .part-title {\r\n        background-color: black;\r\n        color: white !important;\r\n        font-size: 16px;\r\n        padding: 5px;\r\n        display: inline;\r\n    }\r\n\r\n    .question-item {\r\n        display: flex;\r\n        justify-content: space-between;\r\n        margin-bottom: 10px;\r\n    }\r\n\r\n    .number-box {\r\n        border: 1px solid black;\r\n        width: 90px;\r\n        text-align: right;\r\n        padding-right: 10px;\r\n        margin-left: 10px;\r\n    }\r\n\r\n    .row {\r\n        margin-bottom: 10px;\r\n    }\r\n\r\n    .input-box {\r\n        width: 100px;\r\n        height: 20px;\r\n        display: inline-block;\r\n        border: 1px solid #000;\r\n        vertical-align: middle;\r\n    }\r\n\r\n    /* Aligns labels and inputs in the same line */\r\n    .calculation-row {\r\n        display: block;\r\n        margin-bottom: 10px;\r\n    }\r\n\r\n    .label-text {\r\n        display: inline-block;\r\n        vertical-align: middle;\r\n        width: 50%;\r\n    }\r\n\r\n    .calculation-inputs {\r\n        display: inline-block;\r\n        vertical-align: middle;\r\n        width: 45%;\r\n    }\r\n\r\n    .calculation-inputs .input-box {\r\n        margin-left: 4px;\r\n    }\r\n\r\n    /* New styling for column headers */\r\n    .header-row {\r\n        display: flex;\r\n        justify-content: flex-end;\r\n        margin-bottom: 5px;\r\n    }\r\n\r\n    .header-column {\r\n        width: 100px;\r\n        /* Matches the width of the input boxes */\r\n        text-align: center;\r\n        font-weight: bold;\r\n    }\r\n\r\n    .question-item {\r\n        display: flex;\r\n        justify-content: space-between;\r\n        margin-bottom: 10px;\r\n    }\r\n\r\n    body {\r\n        font-family: Arial, sans-serif;\r\n        margin: 20px;\r\n    }\r\n\r\n    /* Flexbox container to align box and box1 in one row */\r\n    .flex-row1 {\r\n        display: flex;\r\n        /* Align items at the top */\r\n        width: 100%;\r\n        /* Full width */\r\n    }\r\n\r\n    .box {\r\n        border: 1px solid black;\r\n        width: 51%;\r\n        font-size: 13px;\r\n        box-sizing: border-box;\r\n        display: inline-block;\r\n        vertical-align: top;\r\n\r\n    }\r\n\r\n    .box1 {\r\n        border: 1px solid black;\r\n        width: 48%;\r\n        font-size: 13px;\r\n        box-sizing: border-box;\r\n        display: inline-block;\r\n        vertical-align: top;\r\n\r\n\r\n    }\r\n\r\n    .part-title {\r\n        background-color: black;\r\n        color: white !important;\r\n        font-size: 16px;\r\n        padding: 5px;\r\n        display: inline;\r\n    }\r\n\r\n    .border {\r\n        border-top: 2px solid black;\r\n        border-bottom: 2px solid black;\r\n    }\r\n\r\n    .checkbox1 {\r\n        display: inline-block;\r\n        width: 12px;\r\n        height: 12px;\r\n        border: 1px solid black;\r\n        margin-right: 5px;\r\n        vertical-align: middle;\r\n    }\r\n\r\n    .input-box {\r\n        width: 102px;\r\n        height: 20px;\r\n        display: inline-block;\r\n        border: 1px solid #000;\r\n        vertical-align: middle;\r\n    }\r\n\r\n    /* Form Fields */\r\n    .input-box1 {\r\n        width: 100%;\r\n        padding: 8px;\r\n        border: 1px solid #000;\r\n        box-sizing: border-box;\r\n        margin-top: 5px;\r\n    }\r\n\r\n    .signature-box {\r\n        width: 100%;\r\n        height: 90px;\r\n        border: 2px solid black;\r\n        box-sizing: border-box;\r\n    }\r\n\r\n    .input-box.small {\r\n        width: 35px;\r\n    }\r\n\r\n    /* Date Input Container */\r\n    .date-container {\r\n        display: inline-block;\r\n        margin-top: 5px;\r\n    }\r\n\r\n    .date-box {\r\n        border: 1px solid black;\r\n        display: inline-block;\r\n        padding: 5px;\r\n    }\r\n\r\n    .date-input {\r\n        width: 30px;\r\n        text-align: center;\r\n        border: none;\r\n        outline: none;\r\n    }\r\n\r\n    /* Column Layout - Converted to Block for PDF */\r\n    .row {\r\n        display: block;\r\n        margin-bottom: 10px;\r\n    }\r\n\r\n    /* Field group: inline-block for alignment in PDF */\r\n    .field-group {\r\n        display: inline-block;\r\n        width: 40%;\r\n        vertical-align: top;\r\n        margin-right: 1%;\r\n    }\r\n\r\n    .field-group label {\r\n        display: block;\r\n        margin-bottom: 5px;\r\n        font-size: 12px;\r\n    }\r\n\r\n    .field-group:last-child {\r\n        margin-right: 0;\r\n    }\r\n\r\n    /* Paid Preparer Section */\r\n    .paid-preparer {\r\n        margin-top: 20px;\r\n    }\r\n\r\n\r\n    /* Hide the default checkbox */\r\n    .checkbox {\r\n        appearance: none;\r\n        -webkit-appearance: none;\r\n        -moz-appearance: none;\r\n        width: 20px;\r\n        height: 20px;\r\n        border: 1px solid #000;\r\n        border-radius: 3px;\r\n        position: relative;\r\n        cursor: pointer;\r\n    }\r\n\r\n    /* Create a custom checkmark when checked */\r\n    .checkbox:checked::before {\r\n        content: '\u2714';\r\n        /* Checkmark character */\r\n        font-size: 16px;\r\n        color: black;\r\n        /* Color of the checkmark */\r\n        position: absolute;\r\n        top: -3px;\r\n        left: 2px;\r\n    }\r\n</style>\r\n\r\n<body>\r\n    <div><span class=\"h5\">Form </span><span class=\"h1\">941 for {{doc.year}}: Employer's Quarterly Federal Tax Return</span>\r\n    </div>\r\n    <div class=\"h5\">(Rev. March {{doc.year}})\r\n        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Department\r\n        of the Treasury \u2014 Internal Revenue Service</div>\r\n\r\n    <!-- EIN and Quarters Section -->\r\n    <div class=\"flex-row\">\r\n        <!-- EIN Section (Form Container) -->\r\n        <div class=\"form-container\">\r\n            <!-- EIN Section -->\r\n            <div>\r\n                <div class=\"inline-label\">Employer identification number (EIN)</div>\r\n                <div class=\"ein-container\">\r\n                    <input type=\"text\" class=\"input-box small\" maxlength=\"1\" value=\"{{doc.digit1}}\" />\r\n                    <input type=\"text\" class=\"input-box small\" maxlength=\"1\" value=\"{{doc.digit2}}\" />\r\n                    <span> - </span>\r\n                    <input type=\"text\" class=\"input-box small\" maxlength=\"1\" value=\"{{doc.digit3}}\" />\r\n                    <input type=\"text\" class=\"input-box small\" maxlength=\"1\" value=\"{{doc.digit4}}\" />\r\n                    <input type=\"text\" class=\"input-box small\" maxlength=\"1\" value=\"{{doc.digit5}}\" />\r\n                    <input type=\"text\" class=\"input-box small\" maxlength=\"1\" value=\"{{doc.digit6}}\" />\r\n                    <input type=\"text\" class=\"input-box small\" maxlength=\"1\" value=\"{{doc.digit7}}\" />\r\n                    <input type=\"text\" class=\"input-box small\" maxlength=\"1\" value=\"{{doc.digit8}}\" />\r\n                    <input type=\"text\" class=\"input-box small\" maxlength=\"1\" value=\"{{doc.digit9}}\" />\r\n                </div>\r\n            </div>\r\n\r\n            <!-- Name Section -->\r\n            <div>\r\n                <span class=\"inline-label\">Name (not your trade name)</span>\r\n                <input type=\"text\" class=\"input-box\" value=\"{{doc.employer_name}}\">\r\n            </div>\r\n\r\n            <!-- Trade Name Section -->\r\n            <div>\r\n                <span class=\"inline-label\">Trade name (if any)</span>\r\n                <input type=\"text\" class=\"input-box\">\r\n            </div>\r\n\r\n            <!-- Address Section -->\r\n            <!-- Address Section -->\r\n            <div>\r\n                <span class=\"inline-label\">Address</span>\r\n                <div class=\"input-group\">\r\n                    <input type=\"text\" class=\"input-box\" placeholder=\"Number\" style=\"width: 15%;\"\r\n                        value=\"{{ doc.address_line_1.split(' ')[0] }}\" />\r\n                    <input type=\"text\" class=\"input-box\" placeholder=\"Street\" style=\"width: 55%;\"\r\n                        value=\"{{ ' '.join(doc.address_line_1.split(' ')[1:]) }}\" />\r\n                </div><br>\r\n                <div class=\"input-group\">\r\n                    <input type=\"text\" class=\"input-box\" placeholder=\"City\" style=\"width: 35%;\" value=\"{{doc.city}}\" />\r\n                    <input type=\"text\" class=\"input-box\" placeholder=\"State\" style=\"width: 20%;\"\r\n                        value=\"{{doc.state}}\" />\r\n                    <input type=\"text\" class=\"input-box\" placeholder=\"ZIP Code\" style=\"width: 20%;\"\r\n                        value=\"{{doc.foreign_postal_code}}\" />\r\n                </div><br>\r\n                <input type=\"text\" class=\"input-box\" placeholder=\"Foreign country name\" style=\"width: 35%;\"\r\n                    value=\"{{doc.foreign_country_name}}\" />\r\n                <input type=\"text\" class=\"input-box\" placeholder=\"Foreign province/county\" style=\"width: 25%;\"\r\n                    value=\"{{doc.foreign_provincecounty}}\" />\r\n                <input type=\"text\" class=\"input-box\" placeholder=\"Foreign postal code\" style=\"width: 20%;\"\r\n                    value=\"{{ doc.zip_code or '' }}\" />\r\n            </div>\r\n        </div>\r\n\r\n\r\n        <!-- Quarters Section -->\r\n        <div class=\"half-section form-section\">\r\n            <p style=\"background-color: black; color: #fff !important;\">Report for this Quarter of {{doc.year}} (Check one):\r\n            </p>\r\n\r\n            <!-- Checkbox list -->\r\n            <!--<div class=\"checkbox-container\">-->\r\n            <!--    <span class=\"checkbox\"></span>-->\r\n            <!--    <label for=\"q1\" class=\"checkbox-label\"  value=\"{{doc.january_february_march}}\" />1: January, February, March</label>-->\r\n            <!--</div>-->\r\n\r\n            <!--<div class=\"checkbox-container\">-->\r\n            <!--    <span class=\"checkbox\"></span>-->\r\n            <!--    <label for=\"q2\" class=\"checkbox-label\"  value=\"{{doc.april_may_june}}\" />2: April, May, June</label>-->\r\n            <!--</div>-->\r\n\r\n            <!--<div class=\"checkbox-container\">-->\r\n            <!--    <span class=\"checkbox\"></span>-->\r\n            <!--    <label for=\"q3\" class=\"checkbox-label\"  value=\"{{doc.july_august_september}}\" />3: July, August, September</label>-->\r\n            <!--</div>-->\r\n\r\n            <!--<div class=\"checkbox-container\">-->\r\n            <!--    <span class=\"checkbox\"></span>-->\r\n            <!--    <label for=\"q4\" class=\"checkbox-label\"   value=\"{{doc.october_november_december}}\" />4: October, November, December</label>-->\r\n            <!--</div>-->\r\n\r\n\r\n            <!-- Checkbox list -->\r\n            <div class=\"checkbox-container\">\r\n                <input type=\"checkbox\" id=\"q1\" name=\"q1\" class=\"checkbox\" {% if doc.january_february_march %} checked {%\r\n                    endif %}>\r\n                <label for=\"q1\" class=\"checkbox-label\">1: January, February, March</label>\r\n            </div>\r\n\r\n            <div class=\"checkbox-container\">\r\n                <input type=\"checkbox\" id=\"q2\" name=\"q2\" class=\"checkbox\" {% if doc.april_may_june %} checked {% endif\r\n                    %}>\r\n                <label for=\"q2\" class=\"checkbox-label\">2: April, May, June</label>\r\n            </div>\r\n\r\n            <div class=\"checkbox-container\">\r\n                <input type=\"checkbox\" id=\"q3\" name=\"q3\" class=\"checkbox\" {% if doc.july_august_september %} checked {%\r\n                    endif %}>\r\n                <label for=\"q3\" class=\"checkbox-label\">3: July, August, September</label>\r\n            </div>\r\n\r\n            <div class=\"checkbox-container\">\r\n                <input type=\"checkbox\" id=\"q4\" name=\"q4\" class=\"checkbox\" {% if doc.october_november_december %} checked\r\n                    {% endif %}>\r\n                <label for=\"q4\" class=\"checkbox-label\">4: October, November, December</label>\r\n            </div>\r\n\r\n\r\n\r\n            Go to www.irs.gov/Form941 for instructions and the latest information.\r\n        </div>\r\n    </div>\r\n    <br>\r\n    <div class=\"border\">\r\n        <span class=\"part-title\">Part 1:</span>\r\n        <span>Answer these questions for this quarter. Employers in American Samoa, Guam, the Commonwealth of\r\n            the Northern Mariana Islands, the U.S. Virgin Islands, and Puerto Rico can skip lines 2 and 3,\r\n            unless you have employees who are subject to U.S. income tax withholding.</span>\r\n    </div>\r\n\r\n    <br>\r\n    <div>\r\n        <div class=\"question-item\">\r\n            <span>1. Number of employees who received wages, tips, or other compensation</span>\r\n            <input type=\"text\" class=\"number-box\" value=\"{{ doc.number_of_employees }}\" />\r\n        </div>\r\n\r\n        <div class=\"question-item\">\r\n            <span>2. Wages, tips, and other compensation</span>\r\n            <input type=\"text\" class=\"number-box\" value=\"{{ \" {:.2f}\".format(doc.wages_tips_other_compensation) }}\" />\r\n        </div>\r\n\r\n        <div class=\"question-item\">\r\n            <span>3. Federal income tax withheld from wages, tips, and other compensation</span>\r\n            <input type=\"text\" class=\"number-box\" value=\"{{ \" {:.2f}\".format(doc.federal_income_tax_withheld) }}\" />\r\n        </div>\r\n\r\n        <div class=\"question-item\">\r\n            <span>4. If no wages, tips, and other compensation are subject to social security or Medicare\r\n                tax</span>\r\n            <span class=\"checkbox1\"></span><label>Check here and go to line 6.</label>\r\n        </div>\r\n\r\n        <!-- Calculation rows for 5a to 5d -->\r\n        <div class=\"calculation-row\">\r\n            <div class=\"label-text\">5a Taxable social security wages</div>\r\n            <div class=\"calculation-inputs\">\r\n                <input type=\"text\" class=\"input-box\" value=\"{{ \" {:.2f}\".format(doc.taxable_wages) }}\"> \u00d7 0.124 = <input\r\n                    type=\"text\" class=\"input-box\" value=\"{{ \" {:.2f}\".format(doc.social_security_wages) }}\" />\r\n            </div>\r\n        </div>\r\n\r\n        <div class=\"calculation-row\">\r\n            <div class=\"label-text\">5b Taxable social security tips</div>\r\n            <div class=\"calculation-inputs\">\r\n                <input type=\"text\" class=\"input-box\"> \u00d7 0.124 = <input type=\"text\" class=\"input-box\">\r\n            </div>\r\n        </div>\r\n\r\n        <div class=\"calculation-row\">\r\n            <div class=\"label-text\">5c Taxable Medicare wages & tips</div>\r\n            <div class=\"calculation-inputs\">\r\n                <input type=\"text\" class=\"input-box\" value=\"{{ \" {:.2f}\".format(doc.taxable_wages_medicare) }}\"> \u00d7 0.029 =\r\n                <input type=\"text\" class=\"input-box\" value=\"{{ \" {:.2f}\".format(doc.medicare_wages_and_tips) }}\">\r\n            </div>\r\n\r\n        </div>\r\n\r\n        <div class=\"calculation-row\">\r\n            <div class=\"label-text\">5d Taxable wages & tips subject to Additional Medicare Tax withholding</div>\r\n            <div class=\"calculation-inputs\">\r\n                <input type=\"text\" class=\"input-box\"> \u00d7 0.009 = <input type=\"text\" class=\"input-box\">\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Total taxes line -->\r\n        <div class=\"question-item\">\r\n            <span> 5e Total social security and Medicare taxes. Add Column 2 from lines 5a, 5b, 5c, and 5d . . .\r\n                .\r\n                5e</span>\r\n            <input type=\"text\" class=\"number-box\" value=\"{{ \" {:.2f}\".format(doc.total_social_security_and_medicare_taxes) }}\">\r\n        </div>\r\n        <div class=\"question-item\">\r\n            <span> 5f Section 3121(q) Notice and Demand\u2014Tax due on unreported tips (see instructions) . .\r\n            </span>\r\n            <input type=\"text\" class=\"number-box\">\r\n        </div>\r\n        <div class=\"question-item\">\r\n            <span> 6 Total taxes before adjustments. Add lines 3, 5e, and 5f . . . . . . . . . . . . </span>\r\n            <input type=\"text\" class=\"number-box\" value=\"{{ \" {:.2f}\".format(doc.total_taxes_before_adjustments) }}\">\r\n        </div>\r\n        <div class=\"question-item\">\r\n            <span> 7 Current quarter\u2019s adjustment for fractions of cents . . . . . . . . . . . . . </span>\r\n            <input type=\"text\" class=\"number-box\" value=\"{{ \" {:.2f}\".format(doc.current_quarter_adjustment_for_fractions_of_cents) }}\">\r\n        </div>\r\n        <div class=\"question-item\">\r\n            <span> 8 Current quarter\u2019s adjustment for sick pay . . . . . . . . . . . . . . . . </span>\r\n            <input type=\"text\" class=\"number-box\">\r\n        </div>\r\n        <div class=\"question-item\">\r\n            <span> 9 Current quarter\u2019s adjustments for tips and group-term life insurance . . . . . . . </span>\r\n            <input type=\"text\" class=\"number-box\">\r\n        </div>\r\n        <div class=\"question-item\">\r\n            <span> 10 Total taxes after adjustments. Combine lines 6 through 9 . . . . . . . . . . . </span>\r\n            <input type=\"text\" class=\"number-box\" value=\"{{ \" {:.2f}\".format(doc.total_taxes_after_adjustments) }}\">\r\n        </div>\r\n        <div class=\"question-item\">\r\n            <span> 11 Qualified small business payroll tax credit for increasing research activities. Attach\r\n                Form\r\n                8974 </span>\r\n            <input type=\"text\" class=\"number-box\">\r\n        </div>\r\n        <div class=\"question-item\">\r\n            <span> 12 Total taxes after adjustments and nonrefundable credits. Subtract line 11 from line 10 . .\r\n            </span>\r\n            <input type=\"text\" class=\"number-box\" value=\"{{ \" {:.2f}\".format(doc.total_taxes_after_adjustments_and_nonrefundable_credits) }}\">\r\n        </div>\r\n        <div class=\"question-item\">\r\n            <span> 13 Total deposits for this quarter, including overpayment applied from a prior quarter and\r\n                overpayments applied from Form 941-X, 941-X (PR), or 944-X filed in the current quarter </span>\r\n            <input type=\"text\" class=\"number-box\">\r\n        </div>\r\n        <div class=\"question-item\">\r\n            <span> 14 Balance due. If line 12 is more than line 13, enter the difference and see instructions .\r\n                . .\r\n            </span>\r\n            <input type=\"text\" class=\"number-box\" value=\"{{ \" {:.2f}\".format(doc.balance_due) }}\">\r\n        </div>\r\n        <div>\r\n\r\n            15 Overpayment: If line 13 is more than line 12, enter the difference <input type=\u201ctext\u201d\r\n                class=\u201cnumber-box\u201d>. Check one: <span class=\"checkbox1\"></span> Apply to next return. <span\r\n                class=\"checkbox1\"></span> Send a refund.\r\n\r\n        </div>\r\n    </div><br>\r\n\r\n    <div class=\"flex-row1\">\r\n        <div class=\"box\">\r\n            <span class=\"inline-label\">Name (not your trade name)</span><br>\r\n            <input type=\"text\" style=\"box-sizing: border-box; width: 80%\" value=\"{{doc.employer_name}}\">\r\n        </div>\r\n        <div class=\"box1\">\r\n            <span class=\"inline-label\">Employer identification number (EIN)</span><br>\r\n            &nbsp;&nbsp;&nbsp;&nbsp;<input type=\"text\" style=\"box-sizing: border-box; width: 20%\" value=\"{{doc.employer_identification_number_ein[:2]}}\">-<input type=\"text\"\r\n                style=\"box-sizing: border-box; width: 40%\" value=\"{{doc.employer_identification_number_ein[2:]}}\">\r\n        </div>\r\n    </div>\r\n    <div class=\"border\">\r\n        <span class=\"part-title\">Part 2:</span>\r\n        <span> Tell us about your deposit schedule and tax liability for this quarter.</span>\r\n    </div>\r\n    <div>If you\u2019re unsure about whether you\u2019re a monthly schedule depositor or a semiweekly schedule depositor,\r\n        see\r\n        section 11 of Pub. 15.</div>\r\n    <div>\r\n        <p>Check one:</p>\r\n        <div>\r\n            <span class=\"checkbox1\"></span>\r\n            <label>Line 12 on this return is less than $2,500 or line 12 on the return for\r\n                the\r\n                prior quarter was less than $2,500,\r\n                and you didn\u2019t incur a $100,000 next-day deposit obligation during the current quarter. If line\r\n                12\r\n                for\r\n                the prior\r\n                quarter was less than $2,500 but line 12 on this return is $100,000 or more, you must provide a\r\n                record\r\n                of your\r\n                federal tax liability. If you\u2019re a monthly schedule depositor, complete the deposit schedule\r\n                below;\r\n                if\r\n                you\u2019re a\r\n                semiweekly schedule depositor, attach Schedule B (Form 941). Go to Part 3.</label><br>\r\n            <span class=\"checkbox1\"></span>\r\n            <label>You were a monthly schedule depositor for the entire quarter. Enter your\r\n                tax\r\n                liability for each month and total\r\n                liability for the quarter, then go to Part 3.</label>\r\n        </div>\r\n\r\n        <!-- Tax Liability Section -->\r\n        <div>\r\n            <div>\r\n                <span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Tax liability: Month\r\n                    1</span>\r\n                <input type=\"text\" class=\"input-box\" value=\"{{ \" {:.2f}\".format(doc.first_month) }}\">\r\n            </div>\r\n\r\n            <div>\r\n                <span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Month\r\n                    2</span>\r\n                <input type=\"text\" class=\"input-box\" value=\"{{ \" {:.2f}\".format(doc.second_month) }}\">\r\n            </div>\r\n\r\n            <div>\r\n                <span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Month\r\n                    3</span>\r\n                <input type=\"text\" class=\"input-box\" value=\"{{ \" {:.2f}\".format(doc.third_month) }}\">\r\n            </div>\r\n\r\n            <div>\r\n                <span>Total liability for the quarter\r\n                    <input type=\"text\" value=\"{{ \" {:.2f}\".format(doc.balance_due) }}\">Total must equal line 12</span>\r\n            </div>\r\n            <div>\r\n                <span class=\"checkbox1\"></span>\r\n                <label> You were a semiweekly schedule depositor for any part of this\r\n                    quarter.\r\n                    Complete Schedule B (Form 941),\r\n                    Report of Tax Liability for Semiweekly Schedule Depositors, and attach it to Form 941. Go to\r\n                    Part\r\n                    3.</label>\r\n            </div>\r\n        </div>\r\n\r\n    </div>\r\n    <div>If you\u2019re unsure about whether you\u2019re a monthly schedule depositor or a semiweekly schedule depositor,\r\n        see\r\n        section 11 of Pub. 15.\r\n    </div><br>\r\n    <div>\r\n        <div class=\"border\">\r\n            <span class=\"part-title\">Part 3:</span>\r\n            <span> Tell us about your business. If a question does NOT apply to your business, leave it\r\n                blank.</span>\r\n        </div>\r\n        <div>\r\n            17 If your business has closed or you stopped paying wages . . . . . . . . . . . . . . .\r\n            <span class=\"checkbox1\"></span>\r\n            Check here and enter the final date you paid wages\r\n            <span class=\"date-container\">\r\n                <div class=\"date-box\">\r\n                    <input type=\"text\" maxlength=\"2\" class=\"date-input\" placeholder=\"MM\">\r\n                    <span class=\"slash\">/</span>\r\n                    <input type=\"text\" maxlength=\"2\" class=\"date-input\" placeholder=\"DD\">\r\n                    <span class=\"slash\">/</span>\r\n                    <input type=\"text\" maxlength=\"4\" class=\"date-input\" placeholder=\"YYYY\">\r\n                </div>\r\n            </span>\r\n            ; also attach a statement to your return. See instructions.\r\n        </div>\r\n        <div>\r\n\r\n            18 If you\u2019re a seasonal employer and you don\u2019t have to file a return for every quarter of the year .\r\n            . .\r\n            <span class=\"checkbox1\"></span> Check here.\r\n        </div><br>\r\n\r\n        <div class=\"border\">\r\n            <span class=\"part-title\">Part 4:</span>\r\n            <span> May we speak with your third-party designee?</span>\r\n        </div>\r\n        <div> Do you want to allow an employee, a paid tax preparer, or another person to discuss this return\r\n            with\r\n            the\r\n            IRS? See the instructions\r\n            for details.</div>\r\n\r\n    </div>\r\n    <div>\r\n        <span class=\"checkbox1\"></span> Yes. Designee\u2019s name and phone number <input type=\"text\"\r\n            class=\"total-liability-box\">&nbsp;&nbsp;\r\n        <input type=\"text\" class=\"