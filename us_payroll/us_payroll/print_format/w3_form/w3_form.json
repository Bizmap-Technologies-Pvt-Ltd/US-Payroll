 "html": "<style>\r\n    /* Print & PDF Optimization */\r\n    @page {\r\n        size: letter;\r\n        margin: 0.5in;\r\n    }\r\n\r\n    * {\r\n        box-sizing: border-box;\r\n    }\r\n\r\n    .print-wrapper {\r\n        width: 7in;\r\n        margin: 0 auto;\r\n        background: #fff;\r\n        page-break-inside: avoid;\r\n    }\r\n\r\n    .w3-form-container {\r\n        border: 2px solid #050505;\r\n        padding: 0;\r\n        position: relative;\r\n    }\r\n\r\n    .header-top {\r\n        text-align: center;\r\n        font-weight: bold;\r\n        font-size: 14pt;\r\n        margin-top: -25px;\r\n        position: absolute;\r\n        width: 100%;\r\n    }\r\n\r\n    .w3-table-main {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        table-layout: fixed;\r\n    }\r\n\r\n    .inner-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n    }\r\n\r\n    td {\r\n        vertical-align: top;\r\n        padding: 0;\r\n    }\r\n\r\n    .br {\r\n        border-right: 1px solid #050505;\r\n    }\r\n\r\n    .bb {\r\n        border-bottom: 1px solid #050505;\r\n    }\r\n\r\n    .lbl {\r\n        font-size: 7pt;\r\n        padding: 2px 4px;\r\n        line-height: 0.9;\r\n        display: block;\r\n    }\r\n\r\n    .lbl-red-bold {\r\n        font-weight: bold;\r\n        font-size: 8pt;\r\n        padding: 2px 4px;\r\n    }\r\n\r\n    .red-bold {\r\n        font-weight: bold;\r\n        font-size: 9pt;\r\n    }\r\n\r\n    /* TABLE HEIGHT REDUCTION */\r\n    .val {\r\n        min-height: 7pt;\r\n        padding: 1px 4px;\r\n        font-size: 10pt;\r\n    }\r\n\r\n    .inner-table td {\r\n        padding-top: 0;\r\n        padding-bottom: 0;\r\n    }\r\n\r\n    .w3-table-main td {\r\n        line-height: 1;\r\n    }\r\n\r\n    .ctrl-box {\r\n        border: 1px solid #050505;\r\n        font-family: monospace;\r\n        font-size: 16pt;\r\n        font-weight: bold;\r\n        margin: 4px;\r\n        text-align: center;\r\n    }\r\n\r\n    .cb-grid {\r\n        display: table;\r\n        width: 100%;\r\n    }\r\n\r\n    .cb-item {\r\n        display: table-cell;\r\n        font-size: 6pt;\r\n        text-align: center;\r\n        padding: 2px;\r\n        vertical-align: top;\r\n    }\r\n\r\n    .box {\r\n        width: 8pt;\r\n        height: 8pt;\r\n        border: 1px solid #050505;\r\n        margin: 1px auto;\r\n        background: #fff;\r\n    }\r\n\r\n    .lbl-small {\r\n        font-size: 6pt;\r\n        text-align: center;\r\n    }\r\n\r\n    .shaded {\r\n        -webkit-print-color-adjust: exact;\r\n    }\r\n</style>\r\n\r\n<div class=\"print-wrapper\">\r\n    <div class=\"w3-form-container\">\r\n        <table class=\"w3-table-main\">\r\n\r\n            <!-- Row 1 -->\r\n            <tr>\r\n                <td style=\"width:15%;\" class=\"br bb\">\r\n                    <div class=\"ctrl-box\">33333</div>\r\n                </td>\r\n                <td style=\"width:35%;\" class=\"br bb\">\r\n                    <span class=\"lbl\"><span class=\"red-bold\">a</span> Control number</span>\r\n                    <div class=\"val\"></div>\r\n                </td>\r\n                <td style=\"width:50%;\" class=\"bb\">\r\n                    <span class=\"lbl-red-bold\">For Official Use Only:</span><br>\r\n                    <span class=\"lbl-red-bold\">OMB No. 1545-0029</span>\r\n                </td>\r\n            </tr>\r\n\r\n            <!-- Row 2 -->\r\n            <tr>\r\n                <!-- Kind of Payer -->\r\n                <td colspan=\"2\" class=\"br bb\">\r\n                    <table class=\"inner-table\">\r\n                        <tr>\r\n                            <td style=\"width:80px;\">\r\n                                <span class=\"red-bold\">b</span><br>\r\n                                <span class=\"lbl-red-bold\">Kind of Payer <br><br> (Check one)</span>\r\n                            </td>\r\n                            <td>\r\n                                <div class=\"cb-grid\">\r\n                                    <div class=\"cb-item\">941<div class=\"box\"></div>\r\n                                    </div>\r\n                                    <div class=\"cb-item\">Military<div class=\"box\"></div>\r\n                                    </div>\r\n                                    <div class=\"cb-item\">943<div class=\"box\"></div>\r\n                                    </div>\r\n                                    <div class=\"cb-item\">944<div class=\"box\"></div>\r\n                                    </div>\r\n                                </div>\r\n                                <div class=\"cb-grid\">\r\n                                    <div class=\"cb-item\">CT-1<div class=\"box\"></div>\r\n                                    </div>\r\n                                    <div class=\"cb-item\">Hshld.<br> emp.<div class=\"box\"></div>\r\n                                    </div>\r\n                                    <div class=\"cb-item\">Medicare<br> govt. emp.<div class=\"box\"></div>\r\n                                    </div>\r\n                                </div>\r\n                            </td>\r\n                        </tr>\r\n                    </table>\r\n                </td>\r\n\r\n                <!-- Kind of Employer -->\r\n                <td class=\"bb\">\r\n                    <table class=\"inner-table\">\r\n                        <tr>\r\n                            <td style=\"width:80px;\">\r\n                                <span class=\"lbl-red-bold\">Kind of Employer <br><br> (Check one)</span>\r\n                            </td>\r\n                            <td>\r\n                                <div class=\"cb-grid\">\r\n                                    <div class=\"cb-item\">None apply<div class=\"box\"></div>\r\n                                    </div>\r\n                                    <div class=\"cb-item\">501c non-govt.<div class=\"box\"></div>\r\n                                    </div>\r\n                                </div>\r\n                                <div class=\"cb-grid\">\r\n                                    <div class=\"cb-item\">State/local non-501c<div class=\"box\"></div>\r\n                                    </div>\r\n                                    <div class=\"cb-item\">State/local 501c<div class=\"box\"></div>\r\n                                    </div>\r\n                                    <div class=\"cb-item\">Federal govt<div class=\"box\"></div>\r\n                                    </div>\r\n                                </div>\r\n                            </td>\r\n                            <td style=\"width:80px; border-left:1px dashed #050505;\">\r\n                                <span class=\"lbl-small\">\r\n                                    Third-party<br>sick pay<br><br>(Check if applicable)\r\n                                </span>\r\n                                <div class=\"box\"></div>\r\n                            </td>\r\n                        </tr>\r\n                    </table>\r\n                </td>\r\n            </tr>\r\n\r\n            <!-- Row 3 -->\r\n            <tr>\r\n                <td colspan=\"1\" class=\"br bb\"><span class=\"lbl\"><span class=\"red-bold\">c</span> Total number of Forms\r\n                        W-2</span>\r\n                    <div class=\"val\" style=\"text-align: right;\">{% if doc.employer_identification_number_ein %}{{\r\n                        doc.number_of_w2_forms }}{% else\r\n                        %}&nbsp;{% endif %}</div>\r\n                </td>\r\n                <td colspan=\"1\" class=\"br bb\"><span class=\"lbl\"><span class=\"red-bold\">d</span> Establishment\r\n                        number</span>\r\n                    <div class=\"val\"></div>\r\n                </td>\r\n                <td class=\"bb\">\r\n                    <table class=\"inner-table\">\r\n                        <tr>\r\n                            <td class=\"br\" style=\"width: 50%;\"><span class=\"lbl\"><span class=\"red-bold\">1</span> Wages,\r\n                                    tips, compensation</span>\r\n                                <div class=\"val\" style=\"text-align: right;\"> {% if doc.wages_tips_other_compensation %}\r\n                                    {{ \"{:,.2f}\".format(doc.wages_tips_other_compensation | float) }}\r\n                                    {% else %}&nbsp;{% endif %}</div>\r\n                            </td>\r\n                            <td><span class=\"lbl\"><span class=\"red-bold\">2</span> Federal income tax</span>\r\n                                <div class=\"val\" style=\"text-align: right;\">{% if doc.federal_income_tax_withheld %}\r\n                                    {{ \"{:,.2f}\".format(doc.federal_income_tax_withheld | float) }}\r\n                                    {% else %}&nbsp;{% endif %}</div>\r\n                            </td>\r\n                        </tr>\r\n                    </table>\r\n                </td>\r\n            </tr>\r\n\r\n            <!-- Row 4 -->\r\n            <tr>\r\n                <td colspan=\"2\" class=\"br bb\"><span class=\"lbl\"><span class=\"red-bold\">e</span> Employer identification\r\n                        number (EIN)</span>\r\n                    <div class=\"val\">{% if doc.employer_identification_number_ein %}{{\r\n                        doc.employer_identification_number_ein }}{% else\r\n                        %}&nbsp;{% endif %}</div>\r\n                </td>\r\n                <td class=\"bb\">\r\n                    <table class=\"inner-table\">\r\n                        <tr>\r\n                            <td class=\"br\" style=\"width: 50%;\"><span class=\"lbl\"><span class=\"red-bold\">3</span> Social\r\n                                    security wages</span>\r\n                                <div class=\"val\" style=\"text-align: right;\">{% if doc.social_security_wages %}{{\r\n                                    \"{:,.2f}\".format(doc.social_security_wages | float) }}{% else\r\n                                    %}&nbsp;{% endif %}</div>\r\n                            </td>\r\n                            <td><span class=\"lbl\"><span class=\"red-bold\">4</span> Social security tax</span>\r\n                                <div class=\"val\" style=\"text-align: right;\"> {% if doc.social_security_tax_withheld %}{{\r\n                                    \"{:,.2f}\".format(doc.social_security_tax_withheld | float)\r\n                                    }}{% else %}&nbsp;{% endif %}</div>\r\n                            </td>\r\n                        </tr>\r\n                    </table>\r\n                </td>\r\n            </tr>\r\n\r\n            <!-- Row 5 -->\r\n            <tr>\r\n                <td colspan=\"2\" class=\"br bb\"><span class=\"lbl\"><span class=\"red-bold\">f</span> Employer's name</span>\r\n                    <div class=\"val\">{% set comp_doc = frappe.get_all(\"Company\", fields=[\"name\",\"company_name\"], limit=1)[0] %}\r\n    {% set comp_name = comp_doc.company_name or \"\" %}\r\n    {% set comp_id = comp_doc.name or \"\" %} </div>\r\n                </td>\r\n                <td class=\"bb\">\r\n                    <table class=\"inner-table\">\r\n                        <tr>\r\n                            <td class=\"br\" style=\"width: 50%;\"><span class=\"lbl\"><span class=\"red-bold\">5</span>\r\n                                    Medicare wages/tips</span>\r\n                                <div class=\"val\" style=\"text-align: right;\">{% if doc.medicare_wages_and_tips %}{{\r\n                                    \"{:,.2f}\".format(doc.medicare_wages_and_tips | float) }}{% else\r\n                                    %}&nbsp;{% endif %}</div>\r\n                            </td>\r\n                            <td><span class=\"lbl\"><span class=\"red-bold\">6</span> Medicare tax withheld</span>\r\n                                <div class=\"val\" style=\"text-align: right;\">{% if doc.medicare_tax_withheld %}{{\r\n                                    \"{:,.2f}\".format(doc.medicare_tax_withheld | float) }}{% else\r\n                                    %}&nbsp;{% endif %}</div>\r\n                            </td>\r\n                        </tr>\r\n                    </table>\r\n                </td>\r\n            </tr>\r\n\r\n            <!-- Row 6 -->\r\n\r\n            <tr>\r\n                <td colspan=\"2\" rowspan=\"3\" class=\"br bb\"> <span class=\"lbl\"><span class=\"red-bold\">g</span> Employer's\r\n                        address and ZIP code</span>\r\n                    <div class=\"name-value\">\r\n\r\n                        {% set addr = frappe.db.get_value(\"Address\", {\"address_title\": comp_name}, [\r\n                        \"address_line1\",\"address_line2\",\"city\",\"state\",\"pincode\",\"country\"\r\n                        ], as_dict=True) %}\r\n\r\n                        {% if addr %}\r\n                        {% if addr.address_line1 %}{{ addr.address_line1 }}<br>{% endif %}\r\n                        {% if addr.address_line2 %}{{ addr.address_line2 }}<br>{% endif %}\r\n                        {% if addr.city or addr.state or addr.pincode %}\r\n                        {{ addr.city }}{% if addr.state %}, {{ addr.state }}{% endif %}\r\n                        {% if addr.pincode %} {{ addr.pincode }}{% endif %}<br>\r\n                        {% endif %}\r\n                        {% if addr.country %}{{ addr.country }}{% endif %}\r\n                        {% else %}\r\n                        &nbsp;\r\n                        {% endif %}\r\n                    </div>\r\n                </td>\r\n                <td class=\"bb\">\r\n                    <table class=\"inner-table\">\r\n                        <tr>\r\n                            <td class=\"br\" style=\"width: 50%;\"> <span class=\"lbl\"><span class=\"red-bold\">7</span> Social\r\n                                    security tips</span>\r\n                                <div class=\"val\"></div>\r\n                            </td>\r\n                            <td> <span class=\"lbl\"><span class=\"red-bold\">8</span> Allocated tips</span>\r\n                                <div class=\"val\"></div>\r\n                            </td>\r\n                        </tr>\r\n                    </table>\r\n                </td>\r\n            </tr> <!-- Row 7: 9 and 10 -->\r\n            <tr>\r\n                <td class=\"bb\">\r\n                    <table class=\"inner-table\">\r\n                        <tr>\r\n                            <td class=\"br shaded\" style=\"width: 50%;\"> <span class=\"lbl\"><span\r\n                                        class=\"red-bold\">9</span></span>\r\n                                <div class=\"val\"></div>\r\n                            </td>\r\n                            <td> <span class=\"lbl\"><span class=\"red-bold\">10</span> Dependent care benefits</span>\r\n                                <div class=\"val\"></div>\r\n                            </td>\r\n                        </tr>\r\n                    </table>\r\n                </td>\r\n            </tr> <!-- Row 8: 11 and 12a -->\r\n            <tr>\r\n                <td class=\"bb\">\r\n                    <table class=\"inner-table\">\r\n                        <tr>\r\n                            <td class=\"br\" style=\"width: 50%;\"> <span class=\"lbl\"><span class=\"red-bold\">11</span>\r\n                                    Nonqualified plans</span>\r\n                                <div class=\"val\"></div>\r\n                            </td>\r\n                            <td> <span class=\"lbl\"><span class=\"red-bold\">12a</span> Deferred compensation</span>\r\n                                <div class=\"val\"></div>\r\n                            </td>\r\n                        </tr>\r\n                    </table>\r\n                </td>\r\n            </tr>\r\n            <!-- Row 8 -->\r\n            <tr>\r\n                <td colspan=\"2\" class=\"br bb\"><span class=\"lbl\"><span class=\"red-bold\">h</span> Other EIN used this\r\n                        year</span>\r\n                    <div class=\"val\"></div>\r\n                </td>\r\n                <td class=\"bb\">\r\n                    <table class=\"inner-table\">\r\n                        <tr>\r\n                            <td class=\"br\" style=\"width: 50%;\"><span class=\"lbl\"><span class=\"red-bold\">13</span>\r\n                                    3rd-party sick pay</span>\r\n                                <div class=\"val\"></div>\r\n                            </td>\r\n                            <td class=\"shaded\"><span class=\"lbl\"><span class=\"red-bold\">12b</span></span>\r\n                                <div class=\"val\"></div>\r\n                            </td>\r\n                        </tr>\r\n                    </table>\r\n                </td>\r\n            </tr>\r\n\r\n            <!-- Row 9 -->\r\n            <tr>\r\n                <td class=\"br bb\"><span class=\"lbl\"><span class=\"red-bold\">15</span> State</span>\r\n                    <div class=\"val\"></div>\r\n                </td>\r\n                <td class=\"br bb\"><span class=\"lbl\">Employer's state ID</span>\r\n                    <div class=\"val\"></div>\r\n                </td>\r\n                <td class=\"bb\">\r\n                    <table class=\"inner-table\">\r\n                        <tr>\r\n\r\n                            <td class=\"shaded\"><span class=\"lbl\"><span>14 Income tax withheld by payer of third-party\r\n                                        sick</span></span>\r\n                                <div class=\"val\"></div>\r\n                            </td>\r\n                        </tr>\r\n                    </table>\r\n                </td>\r\n            </tr>\r\n\r\n            <!-- Row 10 -->\r\n            <tr>\r\n                <td colspan=\"3\" class=\"bb\">\r\n                    <table class=\"inner-table\">\r\n                        <tr>\r\n                            <td class=\"br\" style=\"width: 25%;\"><span class=\"lbl\"><span class=\"red-bold\">16</span> State\r\n                                    wages</span>\r\n                                <div class=\"val\"></div>\r\n                            </td>\r\n                            <td class=\"br\" style=\"width: 25%;\"><span class=\"lbl\"><span class=\"red-bold\">17</span> State\r\n                                    income tax</span>\r\n                                <div class=\"val\"></div>\r\n                            </td>\r\n                            <td class=\"br\" style=\"width: 25%;\"><span class=\"lbl\"><span class=\"red-bold\">18</span> Local\r\n                                    wages</span>\r\n                                <div class=\"val\"></div>\r\n                            </td>\r\n                            <td style=\"width: 25%;\"><span class=\"lbl\"><span class=\"red-bold\">19</span> Local income\r\n                                    tax</span>\r\n                                <div class=\"val\"></div>\r\n                            </td>\r\n                        </tr>\r\n                    </table>\r\n                </td>\r\n            </tr>\r\n\r\n            <!-- Row 11 -->\r\n            <tr>\r\n                <td colspan=\"2\" class=\"br bb\"><span class=\"lbl\"><span class=\"red-bold\"></span> Employer\u2019s contact\r\n                        person</span>\r\n                    <div class=\"val\"></div>\r\n                </td>\r\n                <td class=\"bb\">\r\n                    <table class=\"inner-table\">\r\n                        <tr>\r\n                            <td class=\"br\" style=\"width: 50%;\"><span class=\"lbl\"><span class=\"red-bold\"></span>\r\n                                    Employer\u2019s telephone number</span>\r\n                                <div class=\"val\"></div>\r\n                            </td>\r\n                            <td><span class=\"lbl\"><span class=\"red-bold\"></span> For Official Use Only</span>\r\n                                <div class=\"val\"></div>\r\n                            </td>\r\n                        </tr>\r\n                    </table>\r\n                </td>\r\n            </tr>\r\n\r\n            <!-- Row 12 -->\r\n            <tr>\r\n                <td colspan=\"2\" class=\"br bb\"><span class=\"lbl\"><span class=\"red-bold\"></span> Employer\u2019s fax\r\n                        number</span>\r\n                    <div class=\"val\"></div>\r\n                </td>\r\n                <td colspan=\"2\" class=\"br bb\"><span class=\"lbl\"><span class=\"red-bold\"></span> Employer\u2019s fax\r\n                        number</span>\r\n                    <div class=\"val\"></div>\r\n                </td>\r\n\r\n            </tr>\r\n        </table>\r\n    </div>\r\n</div>",
