 "font_size": 14,
 "html": "<style>\r\n    @page {\r\n        size: A4;\r\n        margin: 0;\r\n    }\r\n\r\n    body {\r\n        margin: 0;\r\n        padding: 0;\r\n        font-family: \"Courier New\", Courier, monospace;\r\n    }\r\n\r\n    .w2-canvas {\r\n        position: relative;\r\n        width: 7in;\r\n        height: 10in;\r\n        margin: 0 auto;\r\n        background: url(\"\") no-repeat;\r\n        background-size: 7in 10.9in;\r\n    }\r\n\r\n    /* Common value style */\r\n    .w2-val {\r\n        position: absolute;\r\n        font-size: 9px;\r\n        font-weight: 700;\r\n        white-space: nowrap;\r\n    }\r\n\r\n    .w2-left {\r\n        text-align: left;\r\n    }\r\n\r\n    .w2-center {\r\n        text-align: center;\r\n    }\r\n\r\n    .w2-right {\r\n        text-align: right;\r\n    }\r\n\r\n    .checkbox {\r\n        font-size: 10px;\r\n        font-weight: 700;\r\n    }\r\n</style>\r\n\r\n<div class=\"w2-canvas\">\r\n\r\n    {# --- Global Company Fetch --- #}\r\n    {% set comp_doc = frappe.get_all(\"Company\", fields=[\"name\",\"company_name\"], limit=1)[0] %}\r\n    {% set comp_name = comp_doc.company_name or \"\" %}\r\n    {% set comp_id = comp_doc.name or \"\" %}\r\n\r\n    {# --- Company Address (checkbox checked) --- #}\r\n    {% set comp_addr = frappe.db.sql(\"\"\"\r\n    SELECT address_line1, address_line2, city, state, pincode, country\r\n    FROM `tabAddress`\r\n    WHERE is_your_company_address = 1\r\n    LIMIT 1\r\n    \"\"\", as_dict=True) %}\r\n    {% set comp_addr = comp_addr[0] if comp_addr else {} %}\r\n\r\n    {# --- Employee Details --- #}\r\n    {% if doc.employee %}\r\n    {% set emp = frappe.db.get_value(\"Employee\", {\"name\": doc.employee}, [\r\n    \"employee_name\",\r\n    \"custom_address_line_1\",\"custom_address_line_2\",\r\n    \"custom_city\",\"custom_stateprovince\",\"custom_zip_postal_code\",\"custom_country\"\r\n    ], as_dict=True) or {} %}\r\n    {% else %}\r\n    {% set emp = {} %}\r\n    {% endif %}\r\n\r\n\r\n    <!-- Box a \u2013 SSN -->\r\n    <div class=\"w2-val w2-center\" style=\"top:0.22in; left:1.1in; width:2.8in;\">\r\n        {{ doc.social_security_number }}\r\n    </div>\r\n\r\n    <!-- Box b \u2013 EIN -->\r\n    <div class=\"w2-val w2-center\" style=\"top:0.56in; left:0.25in; width:3.2in;\">\r\n        {{ doc.employer_identification_number_ein }}\r\n    </div>\r\n\r\n    <!-- Box 1 -->\r\n    <div class=\"w2-val w2-right\" style=\"top:0.56in; left:3.59in; width:1.6in;\">\r\n        {{ \"{:,.2f}\".format(doc.wages_tips_other_compensation | float) }}\r\n    </div>\r\n\r\n    <!-- Box 2 -->\r\n    <div class=\"w2-val w2-right\" style=\"top:0.56in; left:5.15in; width:1.6in;\">\r\n        {{ \"{:,.2f}\".format(doc.federal_income_tax_withheld | float) }}\r\n    </div>\r\n\r\n    <!-- Box c \u2013 Employer address -->\r\n    <div class=\"w2-val w2-left\" style=\"top:0.86in; left:0.25in; width:3.2in; line-height:1.1;\">\r\n        {{ comp_name }}\r\n        {% if comp_id and comp_id != comp_name %} ({{ comp_id }}){% endif %}<br>\r\n\r\n        {% if comp_addr.address_line1 %}{{ comp_addr.address_line1 }}<br>{% endif %}\r\n        {% if comp_addr.address_line2 %}{{ comp_addr.address_line2 }}<br>{% endif %}\r\n        {% if comp_addr.city or comp_addr.state or comp_addr.pincode %}\r\n        {{ comp_addr.city or \"\" }} {{ comp_addr.state or \"\" }} {{ comp_addr.pincode or \"\" }}<br>\r\n        {% endif %}\r\n        {% if comp_addr.country %}{{ comp_addr.country }}{% endif %}\r\n    </div>\r\n\r\n    <!-- Box 3 -->\r\n    <div class=\"w2-val w2-right\" style=\"top:0.89in; left:3.55in; width:1.6in;\">\r\n        {{ \"{:,.2f}\".format(doc.social_security_wages | float) }}\r\n    </div>\r\n\r\n    <!-- Box 4 -->\r\n    <div class=\"w2-val w2-right\" style=\"top:0.89in; left:5.15in; width:1.6in;\">\r\n        {{ \"{:,.2f}\".format(doc.social_security_tax_withheld | float) }}\r\n    </div>\r\n\r\n    <!-- Box 5 -->\r\n    <div class=\"w2-val w2-right\" style=\"top:1.23in; left:3.59in; width:1.6in;\">\r\n        {{ \"{:,.2f}\".format(doc.medicare_wages_and_tips | float) }}\r\n    </div>\r\n\r\n    <!-- Box 6 -->\r\n    <div class=\"w2-val w2-right\" style=\"top:1.23in; left:5.15in; width:1.6in;\">\r\n        {{ \"{:,.2f}\".format(doc.medicare_tax_withheld | float) }}\r\n    </div>\r\n\r\n    <!-- Box d \u2013 Control number -->\r\n    <div class=\"w2-val w2-left\" style=\"top:1.89in; left:0.25in; width:3.2in;\">\r\n        {{ doc.control_number }}\r\n    </div>\r\n\r\n    <!-- Box 7 -->\r\n    <div class=\"w2-val w2-right\" style=\"top:2.32in; left:3.55in; width:1.6in;\">\r\n    </div>\r\n\r\n    <!-- Box 8 -->\r\n    <div class=\"w2-val w2-right\" style=\"top:2.32in; left:5.15in; width:1.6in;\">\r\n    </div>\r\n\r\n    <!-- Box e \u2013 Employee name -->\r\n    <div class=\"w2-val w2-left\" style=\"top:2.16in; left:0.26in; width:3.2in;\">\r\n        <span style=\"display:inline-block; width:1.68in;\">\r\n            {{ doc.first_name }} {% if doc.middle_initial %}{{ doc.middle_initial }}{% endif %}\r\n        </span>\r\n        <span style=\"display:inline-block; width:1.7in;\">\r\n            {{ doc.last_name }}\r\n        </span>\r\n    </div>\r\n\r\n    <!-- Box f \u2013 Employee address -->\r\n    <div class=\"w2-val w2-left\" style=\"top:2.55in; left:0.25in; width:3.2in; line-height:1.1;\">\r\n        {% if emp.custom_address_line_1 %}{{ emp.custom_address_line_1 }}<br>{% endif %}\r\n        {% if emp.custom_address_line_2 %}{{ emp.custom_address_line_2 }}<br>{% endif %}\r\n        {% if emp.custom_city or emp.custom_stateprovince or emp.custom_zip_postal_code %}\r\n        {{ emp.custom_city or \"\" }} {{ emp.custom_stateprovince or \"\" }} {{ emp.custom_zip_postal_code or \"\" }}<br>{{ emp.custom_country or \"\" }}\r\n        {% endif %}\r\n    </div>\r\n\r\n    <!-- Box 9 -->\r\n    <div class=\"w2-val w2-right\" style=\"top:2.75in; left:3.55in; width:1.6in;\">\r\n\r\n    </div>\r\n\r\n    <!-- Box 10 -->\r\n    <div class=\"w2-val w2-right\" style=\"top:2.75in; left:5.15in; width:1.6in;\">\r\n    </div>\r\n\r\n    <!-- Box 11 -->\r\n    <div class=\"w2-val w2-right\" style=\"top:3.35in; left:3.55in; width:1.6in;\">\r\n    </div>\r\n\r\n    <!-- Box 12a -->\r\n    <div class=\"w2-val w2-left\" style=\"top:2.16in; left:5.8in; width:1.7in;\">\r\n        &nbsp;&nbsp; DD &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; {{ \"{:,.2f}\".format(doc.medical_insurance | float) }}\r\n    </div>\r\n\r\n    <!-- Box 12b -->\r\n    <div class=\"w2-val w2-left\" style=\"top:3.15in; left:5.2in; width:1.7in;\">\r\n    </div>\r\n\r\n    <!-- Box 12c -->\r\n    <div class=\"w2-val w2-left\" style=\"top:3.45in; left:5.2in; width:1.7in;\">\r\n    </div>\r\n\r\n    <!-- Box 12d -->\r\n    <div class=\"w2-val w2-left\" style=\"top:3.75in; left:5.2in; width:1.7in;\">\r\n    </div>\r\n\r\n    <!-- Box 13 checkboxes -->\r\n    <div class=\"w2-val checkbox\" style=\"top:2.79in; left:4.04in;\">{% if doc.statutory_employee %}x{% endif %}</div>\r\n    {% if doc.tmrs %}\r\n    <div class=\"w2-val checkbox\" style=\"top:2.55in; left:4.82in\">{% if doc.retirement_plan %}x{% endif %}</div>\r\n    {% endif %}\r\n    <div class=\"w2-val checkbox\" style=\"top:3.62in; left:5.58in;\">{% if doc.third_party_sick_pay %}x{% endif %}</div>\r\n\r\n    <!-- Box 14 -->\r\n    {% if doc.tmrs %} <div class=\"w2-val w2-left\" style=\"top:2.85in; left:4.12in; width:3.2in;\">\r\n        TMRS &nbsp;{{ doc.tmrs }}\r\n    </div> {% endif %}\r\n\r\n    <!-- Boxes 15\u201320 -->\r\n    <div class=\"w2-val w2-left\" style=\"top:4.92in; left:0.25in;\"></div>\r\n    <div class=\"w2-val w2-left\" style=\"top:4.92in; left:1.05in;\"></div>\r\n    <div class=\"w2-val w2-right\" style=\"top:4.92in; left:2.35in; width:1.15in;\">\r\n    </div>\r\n    <div class=\"w2-val w2-right\" style=\"top:4.92in; left:3.65in; width:1.15in;\">\r\n    </div>\r\n    <div class=\"w2-val w2-right\" style=\"top:4.92in; left:4.95in; width:1.15in;\">\r\n    </div>\r\n    <div class=\"w2-val w2-right\" style=\"top:4.92in; left:6.25in; width:1.15in;\">\r\n    </div>\r\n    <div class=\"w2-val w2-left\" style=\"top:5.22in; left:4.95in; width:2.5in;\">\r\n    </div>\r\n</div>\r\n\r\n\r\n",
